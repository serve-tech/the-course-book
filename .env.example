# Copy to .env for local development. Never commit .env.
# Local Postgres from `docker compose up -d db` (host port 5433 avoids a
# system Postgres on 5432). The test database is created by docker/init-test-db.sql.
DATABASE_URL=postgres://coursebook:coursebook@localhost:5433/coursebook
DATABASE_URL_TEST=postgres://coursebook:coursebook@localhost:5433/coursebook_test

# Clerk development instance (dashboard -> API keys).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: the instance's JWT public key (PEM, dashboard -> API keys) so the
# API verifies tokens without fetching Clerk's keys.
# CLERK_JWT_KEY=

# API server (apps/api). WEB_ORIGINS lists the exact web origins allowed by
# CORS and in tokens' azp claim; the dev web server runs on 5173.
PORT=3001
WEB_ORIGINS=http://localhost:5173
# Public web address used in the privacy and account-deletion links.
# PUBLIC_WEB_URL=https://coursebook.golf
# Oldest app versions the API still supports (clients must update below these).
# MIN_IOS_VERSION=0.0.0
# MIN_ANDROID_VERSION=0.0.0

# Web app (apps/web). VITE_* values are inlined into the browser bundle at
# build time, so never put a secret in one.
VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Browser tests only: emails of two users in the Clerk development instance,
# each with a username and first name. Leave unset to skip the signed-in
# scenarios. See docs/testing.md.
# E2E_OWNER_EMAIL=owner+clerk_test@example.com
# E2E_FRIEND_EMAIL=friend+clerk_test@example.com

# Course discovery endpoints; override to point at a stub during tests.
OPENGOLF_API_URL=https://api.opengolfapi.org/v1/courses/search
OPENGOLF_CSV_URL=https://raw.githubusercontent.com/opengolfapi/data/main/opengolfapi-us.csv
