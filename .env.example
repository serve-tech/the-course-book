# Copy to .env for local development. Never commit .env.
# The API, tests and scripts load .env automatically, so production
# credentials never go here: keep them in a separate gitignored file (e.g.
# .env.prod, matched by .env.*) and pass them only to the command that needs them.
# Local Postgres from `docker compose up -d db` (host port 5433 avoids a
# system Postgres on 5432). The test database is created by docker/init-test-db.sql.
DATABASE_URL=postgres://coursebook:coursebook@localhost:5433/coursebook
DATABASE_URL_TEST=postgres://coursebook:coursebook@localhost:5433/coursebook_test

# Clerk development instance (dashboard -> API keys).
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Optional: the instance's JWT public key (PEM, dashboard -> API keys) so the
# API verifies tokens without fetching Clerk's keys.
# CLERK_JWT_KEY=

# API server (apps/api). WEB_ORIGINS lists the exact web origins allowed by
# CORS and in tokens' azp claim; the dev web server runs on 5173. Required
# when NODE_ENV=production.
PORT=3001
WEB_ORIGINS=http://localhost:5173
# Public web address used in the privacy and account-deletion links, and read
# for the page a shared ranking link answers with. Leave the default locally
# unless you are checking those pages against your own web app.
# PUBLIC_WEB_URL=https://coursebook.golf
# Oldest app versions the API still supports (clients must update below these).
# MIN_IOS_VERSION=0.0.0
# MIN_ANDROID_VERSION=0.0.0

# Web app (apps/web). VITE_* values are inlined into the browser bundle at
# build time, so never put a secret in one.
VITE_API_URL=http://localhost:3001
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Browser tests only: emails of two users in the Clerk development instance,
# each with a username and first name. Leave unset to skip the signed-in
# scenarios. See docs/testing.md.
# E2E_OWNER_EMAIL=owner+clerk_test@example.com
# E2E_FRIEND_EMAIL=friend+clerk_test@example.com

# Course photo storage (#67): an S3-compatible bucket, Cloudflare R2 in
# production. Leave these unset and uploads stay off, with Commons photos
# served from Commons. The five below turn storage on together; a partial set
# leaves it off and the API logs what is missing. These values match the
# local emulator: `docker compose --profile photos up -d photos`, then
# `pnpm photos:local-bucket`. For the R2 dev bucket instead, use
# https://<account id>.r2.cloudflarestorage.com, coursebook-photos-dev, that
# bucket's token, and its r2.dev address as PHOTO_PUBLIC_URL.
# PHOTO_STORAGE_ENDPOINT=http://localhost:9000
# PHOTO_STORAGE_BUCKET=coursebook-photos-dev
# PHOTO_STORAGE_ACCESS_KEY_ID=coursebook
# PHOTO_STORAGE_SECRET_ACCESS_KEY=coursebook-local-secret
# PHOTO_PUBLIC_URL=http://localhost:9000/coursebook-photos-dev
# Optional: the signing region; R2 uses auto.
# PHOTO_STORAGE_REGION=auto

# Course discovery endpoints; override to point at a stub during tests.
OPENGOLF_API_URL=https://api.opengolfapi.org/v1/courses/search
OPENGOLF_CSV_URL=https://raw.githubusercontent.com/opengolfapi/data/main/opengolfapi-us.csv

# Development seed (pnpm seed:dev): your local username or email, instead of --me.
# SEED_ME=
