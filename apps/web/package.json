{
  "name": "@coursebook/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "coursebook.golf web app: a React Router single-page app and a client of the JSON API.",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc --noEmit",
    "contract:types": "openapi-typescript ../../contract/openapi.json --output app/lib/api/schema.d.ts --default-non-nullable=false"
  },
  "dependencies": {
    "@clerk/react-router": "3.6.24",
    "@coursebook/domain": "workspace:*",
    "@react-router/node": "8.4.0",
    "isbot": "^5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
