{
  "name": "coursebook-golf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @coursebook/web dev",
    "build": "pnpm --filter @coursebook/web build",
    "start": "pnpm --filter @coursebook/web start",
    "typegen": "pnpm --filter @coursebook/web typegen",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "pnpm --filter @coursebook/web typegen && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project domain --project '@coursebook/api (node)' --project '@coursebook/web (node)' --project '@coursebook/web (jsdom)'",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @coursebook/e2e test",
    "db:generate": "pnpm --filter @coursebook/api db:generate",
    "db:check": "pnpm --filter @coursebook/api db:check",
    "db:migrate": "pnpm --filter @coursebook/api db:migrate",
    "seed:build": "pnpm --filter @coursebook/api seed:build",
    "import:supabase": "pnpm --filter @coursebook/api import:supabase",
    "format": "prettier --write apps packages tests/e2e package.json tsconfig.json tsconfig.base.json vitest.config.ts eslint.config.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "prettier": "^3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
