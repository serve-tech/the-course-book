{
  "name": "coursebook-golf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc --noEmit && pnpm -r typecheck",
    "lint": "react-router typegen && eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project node --project jsdom --project domain --project '@coursebook/api (api-node)'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @coursebook/api db:generate",
    "db:check": "pnpm --filter @coursebook/api db:check",
    "db:migrate": "pnpm --filter @coursebook/api db:migrate",
    "seed:build": "pnpm --filter @coursebook/api seed:build",
    "import:supabase": "pnpm --filter @coursebook/api import:supabase",
    "format": "prettier --write app apps packages tests/e2e package.json tsconfig.json tsconfig.base.json vite.config.ts vitest.config.ts playwright.config.ts react-router.config.ts eslint.config.js"
  },
  "dependencies": {
    "@clerk/react-router": "3.6.24",
    "@coursebook/api": "workspace:*",
    "@coursebook/domain": "workspace:*",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "drizzle-orm": "0.45.3",
    "isbot": "^5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "2.2.36",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
